POSTGRES_DB=job_discovery
POSTGRES_USER=job_discovery
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_PORT=5432

DB_URL=jdbc:postgresql://localhost:5432/job_discovery
DB_USERNAME=job_discovery
DB_PASSWORD=replace-with-the-same-local-only-password

# Manual operator API credential. Keep it separate from all future import credentials.
# Use at least 32 high-entropy characters and never commit a real value.
MANUAL_API_KEY=replace-with-a-random-local-key-of-at-least-32-characters
# Optional bounded rotation overlap; configure both values together or neither.
MANUAL_API_PREVIOUS_KEY=
MANUAL_API_PREVIOUS_VALID_UNTIL=

# Official HiringCafe MCP endpoint; override only for a verified endpoint or local mock.
HIRINGCAFE_MCP_URL=https://hiringcafe.com/api/chatgpt/mcp
HIRINGCAFE_CONNECT_TIMEOUT=3s
HIRINGCAFE_REQUEST_TIMEOUT=10s
HIRINGCAFE_RETRY_BACKOFF=200ms
HIRINGCAFE_MAX_RETRY_DELAY=2s
HIRINGCAFE_MAX_ATTEMPTS=3
HIRINGCAFE_RESULT_LIMIT=25
